# Do not commit IDE specific settings
.idea

# Do not commit CMake's debug build
cmake-build-debug
cmake-build-minsizerel
cmake-build-release
cmake-build-relwithdebinfo

# Do not commit CMake preset build directories (CMakePresets.json binaryDir)
build/

# Per-developer CMake presets (template: CMakeUserPresets.json.example)
CMakeUserPresets.json

# Optional per-developer symlink to your preset's compilation database (for clangd)
/compile_commands.json

# Do not commit Static Analyzer Local Builds
.cmake-analysis-build/

# Add Mac's .DS_Store
.DS_Store

# Ignore the market data directory
data/

# Ignore logs written by scripts (e.g. scripts/itch_story/itch_story.py)
logs/

# Ignore __pycache__ from python execution
*/__pycache__